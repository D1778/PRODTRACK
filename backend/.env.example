# ProdTrack backend settings. Copy this file to .env and fill in the values.
# .env is git-ignored - never commit real keys.

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers).
# Leave empty to use a local MongoDB at mongodb://localhost:27017
MONGODB_URI=
MONGODB_DB=prodtrack

# Secret used to sign login tokens (JWT). Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a login lasts, in hours (default 168 = 7 days)
JWT_TTL_HOURS=168

# Server port (Render/Heroku set this automatically)
PORT=8080

# Allowed origin for a separately hosted frontend (e.g. https://your-app.vercel.app). * = any
CORS_ORIGIN=*
