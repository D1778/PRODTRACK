# ProdTrack backend settings. Copy this file to .env and fill in the values.
# .env is git-ignored - never commit real keys.

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers).
# Leave empty to use a local MongoDB at mongodb://localhost:27017
MONGODB_URI=mongodb URI
MONGODB_DB=prodtrack

# Secret used to sign login tokens (JWT). Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a login lasts, in hours (default 168 = 7 days)
JWT_TTL_HOURS=168

# Email verification (signup / first login sends a 6-digit code).
# Leave BREVO_API_KEY empty while developing: the code is printed in the backend
# console instead of being emailed. For real emails:
#   1. Create a free account at https://www.brevo.com
#   2. Settings > Senders & IP > Senders: add and verify the email you send from
#   3. Settings > SMTP & API > API Keys: create a key and paste it below
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=ProdTrack

# The app checks that an email's mailbox really exists BEFORE a code is sent, so a
# fake address gets an error on the signup form instead of a verification page.
#   - By default it asks the recipient's mail server directly (free, no account).
#     This needs outbound port 25, which some hosts block (Render's free plan does);
#     where it is blocked the check is skipped.
#   - For a check that works from any host, use ZeroBounce's validation API:
#       1. Create a free account at https://www.zerobounce.net
#       2. API > API Keys: copy your key and paste it below
ZEROBOUNCE_API_KEY=

# Server port (hosting platforms often set this automatically)
PORT=8080

# Allowed origin for a separately hosted frontend (e.g. https://your-app.vercel.app). * = any
CORS_ORIGIN=*
